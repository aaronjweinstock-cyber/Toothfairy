# Postgres connection string used by the running app (Supabase: the "Connect"
# button -> URI -> transaction pooler, port 6543). Local Postgres in dev can
# just reuse a plain connection string here with no pooler/no sslmode.
#
# Use sslmode=no-verify, not sslmode=require, against Supabase's pooler --
# its certificate chain isn't in Node's default trust store, and newer
# pg-connection-string versions treat "require" as "verify-full" (full
# chain verification) rather than classic libpq "encrypt but don't verify"
# semantics. "require" fails there with "self-signed certificate in
# certificate chain" (Prisma P1011); "no-verify" still encrypts, just
# skips chain verification, which is what we actually want against
# trusted-provider infrastructure like this.
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=no-verify"
# Direct/session connection, used only by `prisma migrate`/`db pull`/`studio`
# (Supabase: same "Connect" dialog -> session pooler, port 5432). The
# transaction pooler above doesn't support what migrations need. Optional --
# falls back to DATABASE_URL when unset (fine for local Postgres, which has
# no pooler distinction). Same sslmode=no-verify note applies here.
DIRECT_URL=""

# Auth.js (NextAuth) session secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Stripe (https://dashboard.stripe.com/apikeys and /webhooks)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Vercel Blob, for tooth photo uploads. Created automatically when you add a
# Blob store to the Vercel project and link it (`vercel env pull`), or
# create one manually at vercel.com/dashboard -> Storage. Optional locally —
# photo uploads are skipped gracefully (post still saves) if unset.
BLOB_READ_WRITE_TOKEN=""

# Public base URL of the app, used to build invite links and Stripe redirect URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (https://resend.com/api-keys), for sending invite emails. Placeholder
# is fine -- EMAIL_SENDING_ENABLED gates whether it's actually called.
RESEND_API_KEY="re_placeholder"
# Must be on a domain verified in Resend (https://resend.com/domains) --
# resend.dev sender addresses only deliver to the account owner. No domain
# is owned yet, so leave EMAIL_SENDING_ENABLED=false until one is verified.
RESEND_FROM_EMAIL="Toothfairy <onboarding@resend.dev>"
# Set to "true" only once RESEND_FROM_EMAIL's domain is verified in Resend --
# until then, the dashboard's "Send invite" button is a no-op (the invite
# link is already shown/copyable, so there's nothing else for it to do).
EMAIL_SENDING_ENABLED="false"
