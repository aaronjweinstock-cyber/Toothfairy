# Postgres connection string (Supabase: Project Settings -> Database -> Connection string -> URI)
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Auth.js (NextAuth) session secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Stripe (https://dashboard.stripe.com/apikeys and /webhooks)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Vercel Blob, for tooth photo uploads. Created automatically when you add a
# Blob store to the Vercel project and link it (`vercel env pull`), or
# create one manually at vercel.com/dashboard -> Storage. Optional locally —
# photo uploads are skipped gracefully (post still saves) if unset.
BLOB_READ_WRITE_TOKEN=""

# Public base URL of the app, used to build invite links and Stripe redirect URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (https://resend.com/api-keys), for sending invite emails. Placeholder
# is fine -- EMAIL_SENDING_ENABLED gates whether it's actually called.
RESEND_API_KEY="re_placeholder"
# Must be on a domain verified in Resend (https://resend.com/domains) --
# resend.dev sender addresses only deliver to the account owner. No domain
# is owned yet, so leave EMAIL_SENDING_ENABLED=false until one is verified.
RESEND_FROM_EMAIL="Toothfairy <onboarding@resend.dev>"
# Set to "true" only once RESEND_FROM_EMAIL's domain is verified in Resend --
# until then, the dashboard's "Send invite" button is a no-op (the invite
# link is already shown/copyable, so there's nothing else for it to do).
EMAIL_SENDING_ENABLED="false"
